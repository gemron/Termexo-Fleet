{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termexo Fleet",
  "version": "0.1.1",
  "identifier": "dev.termexo.fleet",
  "build": {
    "beforeDevCommand": "npm --prefix apps/desktop-ui start -- --host 127.0.0.1 --port 4201",
    "devUrl": "http://127.0.0.1:4201",
    "beforeBuildCommand": "npm --prefix apps/desktop-ui run build",
    "frontendDist": "../apps/desktop-ui/dist/desktop-ui/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Termexo Fleet",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI coding fleet commander for Termexo",
    "longDescription": "Orchestrate one or more Termexo desktop instances with L1-L4 difficulty routing, autonomous sub-agent swarms, self-healing failover, and local execution cost analytics.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
